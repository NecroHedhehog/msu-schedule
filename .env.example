# Скопировать в .env и заполнить. Файл .env в git не попадает.

# --- Обязательное ---

# Токен бота от @BotFather
BOT_TOKEN=
# Куда слать алерты о сбоях парсера. Свой chat_id можно узнать у @userinfobot
ADMIN_CHAT_ID=

# --- Необязательное ---

# Путь к базе относительно корня проекта
DB_PATH=data/schedule.db

# Пауза между запросами к сайту, секунд. Меньше 0.3 не ставить:
# сайт древний и на нагрузку реагирует плохо.
PARSER_REQUEST_DELAY=0.3
# Таймаут одного запроса, секунд
PARSER_REQUEST_TIMEOUT=30
# Сколько всего попыток на запрос (1 = без повторов)
PARSER_MAX_ATTEMPTS=4
# База экспоненциального бэкоффа, секунд: 3, 6, 12, ...
PARSER_RETRY_BACKOFF=3

# Как часто предполагается гонять парсер, часов.
# check_freshness.py ругается, если данных нет дольше двух таких интервалов.
PARSER_INTERVAL_HOURS=4

# Меньше этого числа занятий в группе — повод для предупреждения
MIN_LESSONS_PER_GROUP=10
# Потоки с этими предметами не собираются: занятия для иностранных
# студентов. Через |. Правило по названию предмета, а не по коду группы:
# коды меняются каждый семестр, названия — нет.
SKIP_SUBGROUP_SUBJECTS=Русский язык как иностранный|Русский язык

# Не затирать расписание группы, если пришло меньше этой доли от того,
# что уже лежит в базе за те же даты
SHRINK_GUARD_RATIO=0.5

# --- Свободный блок: нижняя кнопка и подпись под расписанием ---
# Исторически назван AD_*, но это просто слот под произвольный текст:
# сейчас там раздел «Связь».
# Оставьте пустым AD_FULL_TEXT — и кнопка не появится вовсе.
#
# Ник сюда вписывать не нужно: при заданном ADMIN_CHAT_ID бот принимает
# сообщение сам и пересылает его вам. Человек остаётся в боте,
# а ваш аккаунт нигде не показывается.

# Одна строка, приписывается под каждым расписанием. Держите её короткой:
# она попадает под каждое «Сегодня», «Завтра» и «Неделя»
AD_TEASER=💬 Вопрос или ошибка — кнопка «Связь»
# Текст по кнопке, HTML. \n — перевод строки
# Приглашение написать бот допишет сам
AD_FULL_TEXT=💬 <b>Связь</b>\n\nНашли ошибку в расписании или что-то работает не так?

Нашли ошибку в расписании или что-то работает не так?
AD_BUTTON_LABEL=💬 Связь
